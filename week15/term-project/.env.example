# MongoDB Atlas connection string for the application database.
# Create a database user in Atlas and replace the placeholders.
MONGO_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# OpenWeatherMap API key used by the React dashboard forecast.
VITE_WEATHER_KEY=your_openweathermap_api_key

# Google OAuth 2.0 client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth 2.0 client secret from the same OAuth client.
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Example local callback URL; it must exactly match Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Example local React development server URL.
FRONTEND_ORIGIN=http://localhost:5173

# Long random value used to sign Express session cookies.
SESSION_SECRET=replace_with_a_long_random_secret
