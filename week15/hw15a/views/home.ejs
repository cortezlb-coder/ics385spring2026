<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Google OAuth Demo</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        max-width: 680px;
        margin: 3rem auto;
        padding: 0 1rem;
        text-align: center;
      }
      a {
        display: inline-block;
        background: #4285f4;
        color: white;
        text-decoration: none;
        padding: 0.85rem 1.3rem;
        border-radius: 6px;
        margin-top: 1rem;
      }
      a:hover {
        background: #2c6ee5;
      }
    </style>
  </head>
  <body>
    <h1>Welcome</h1>
    <p>Sign in with Google to view your profile.</p>
    <a href="/auth/google">Login with Google</a>
  </body>
</html>
